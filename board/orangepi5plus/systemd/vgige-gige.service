[Unit]
Description=vgige virtual GigE camera (null backend demo)
After=network-online.target
Wants=network-online.target
ConditionPathExists=/root/GenTLite-public/target/release/vgige-cli

[Service]
Type=simple
ExecStartPre=/bin/sh -c 'for i in $(seq 1 30); do ip -4 addr show | grep -q "192.168.137.55" && exit 0; sleep 1; done; exit 1'
ExecStart=/root/GenTLite-public/target/release/vgige-cli --back null --front gige --up 192.168.137.55 --port 3956
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
